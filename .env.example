HAI_API_KEY=
HAI_AGENT_NAME=
GLADIA_API_KEY=
LINKUP_API_KEY=
ANTHROPIC_API_KEY=
# off (default) | h | anthropic: provider allowed to read passport photos, only with the user's consent; no fallback
PASSPORT_READER=
# Trip parsing model (route 2): h (Models API of H) or anthropic (Claude Haiku fallback)
LLM_PROVIDER=h
# Optional: H model id (see GET https://api.hcompany.ai/v1/models), default holo4-27b
HAI_MODEL=
# Optional: Anthropic model id for the fallback, default claude-haiku-4-5
ANTHROPIC_MODEL=
# required in production: access code for the app's paid API routes
NAMI_ACCESS_CODE=
# Local only: absolute folder to search for documents; disabled in production
NAMI_DOCUMENTS_DIR=
# Local passport upload uses Node.js 22+ native WebSocket and an existing Chrome, never launches a browser.
# Chrome CDP port: 9222 by default, 9333 on Nathan's Mac. Match holo local browser --debug-port.
NAMI_AGENT_CHROME_PORT=9222
